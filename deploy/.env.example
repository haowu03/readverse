MYSQL_ROOT_PASSWORD=123456
REDIS_PASSWORD=readverse
RABBITMQ_USER=rv
RABBITMQ_PASSWORD=rv123456
RV_JWT_SECRET=readverse-docker-secret-key-change-in-production-2026

# Host ports (inside Docker: MySQL 3306, Redis 6379, backend 8080, nginx 80)
MYSQL_PORT=13306
REDIS_PORT=6380
BACKEND_PORT=18080
ADMIN_PORT=8081
PORTAL_PORT=8082

# Optional RabbitMQ demo: start with --profile mq, then set true and recreate backend
RV_MQ_ENABLED=false
